# Storage backend: "turso" (hosted, multi-tenant) or omit for local/self-hosted
# STORAGE=turso

# Turso database (turso.tech)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Spotify integration (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Calendar integration (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth0 app-level sign-in (personal tenant)
# Regular Web Application in the Auth0 dashboard; Google is the only
# connection used. Callback URL is <APP_BASE_URL>/auth/callback.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
